# PostgreSQL (R310 / local)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/photography_by_piv"

# Cloudflare R2 (S3-compatible, server only)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"

# Gallery auth (server only)
GALLERY_TOKEN_PEPPER=""
SESSION_SECRET=""

# Optional presigned URL TTLs (seconds)
SIGNED_URL_TTL_THUMB_WEB=900
SIGNED_URL_TTL_ORIGINAL=60

# Share links from scripts/create-gallery-token.ts
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudflare Turnstile (Request to Book form — server secret is never NEXT_PUBLIC_)
# Local testing: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA (always passes)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Dev only (NODE_ENV=development): skip Turnstile, rate limit, and fill-time checks
BOOKING_BOT_CHECKS_DISABLED="false"
