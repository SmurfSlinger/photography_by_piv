[Unit]
Description=Photography by Piv (Next.js)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=smurfslinger
Group=smurfslinger
WorkingDirectory=/home/smurfslinger/photography_by_piv
EnvironmentFile=/home/smurfslinger/photography_by_piv/.env
Environment=NODE_ENV=production
ExecStartPre=/bin/bash -c 'lsof -ti :3000 | xargs -r kill 2>/dev/null || true; sleep 1'
# Public HTTPS is terminated by Caddy; Next listens on localhost only.
ExecStart=/usr/bin/npm run start -- -H 127.0.0.1 -p 3000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
