generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GalleryStatus {
  draft
  active
  archived
}

enum SessionType {
  wedding
  couples
  family
  portrait
  other
}

enum InquiryStatus {
  new
  contacted
  scheduled
  converted_to_booking
  canceled
  archived
}

model Client {
  id        String    @id @default(uuid())
  name      String
  email     String?
  createdAt DateTime  @default(now()) @map("created_at")
  galleries Gallery[]

  @@map("clients")
}

model Gallery {
  id                    String               @id @default(uuid())
  clientId              String               @map("client_id")
  client                Client               @relation(fields: [clientId], references: [id])
  slug                  String               @unique
  title                 String
  status                GalleryStatus        @default(draft)
  allowOriginalDownload Boolean              @default(true) @map("allow_original_download")
  createdAt             DateTime             @default(now()) @map("created_at")
  photos                Photo[]
  accessTokens          GalleryAccessToken[]

  @@map("galleries")
}

model Photo {
  id            String   @id @default(uuid())
  galleryId     String   @map("gallery_id")
  gallery       Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  r2KeyOriginal String   @map("r2_key_original")
  r2KeyWeb      String?  @map("r2_key_web")
  r2KeyThumb    String?  @map("r2_key_thumb")
  filename      String
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([galleryId])
  @@map("photos")
}

model GalleryAccessToken {
  id         String    @id @default(uuid())
  galleryId  String    @map("gallery_id")
  gallery    Gallery   @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  tokenHash  String    @map("token_hash")
  label      String?
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([galleryId])
  @@map("gallery_access_tokens")
}

model BookingInquiry {
  id                     String                 @id @default(uuid())
  createdAt              DateTime               @default(now()) @map("created_at")
  name                   String
  contactMethods         String[]               @map("contact_methods")
  email                  String?
  phone                  String?
  instagramHandle        String?                @map("instagram_handle")
  contactOther           String?                @map("contact_other")
  sessionType            SessionType            @map("session_type")
  sessionTypeOther       String?                @map("session_type_other")
  packageInterest        String                 @map("package_interest")
  preferredDate          DateTime?              @db.Date @map("preferred_date")
  backupDate             DateTime?              @db.Date @map("backup_date")
  locationIdea           String?                @map("location_idea")
  vibeStyle              String?                @map("vibe_style")
  message                String
  status                 InquiryStatus          @default(new)
  adminNotes             String?                @map("admin_notes")
  contactedAt            DateTime?              @map("contacted_at")
  archivedAt             DateTime?              @map("archived_at")
  scheduledAt            DateTime?              @map("scheduled_at")
  externalCalendarId     String?                @map("external_calendar_id")
  spamScore              Int?                   @map("spam_score")
  spamReasons            String[]               @default([]) @map("spam_reasons")
  spamFlagged            Boolean                @default(false) @map("spam_flagged")

  @@index([createdAt])
  @@index([status])
  @@index([spamFlagged])
  @@map("booking_inquiries")
}
